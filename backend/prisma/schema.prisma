// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

model Organization {
  id          String                @id @default(uuid())
  name        String
  description String?
  logoUrl     String?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?
  settings    OrganizationSettings?
  users       User[]
  members     OrganizationMember[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  projects    Project[]
  tasks       Task[]
  taskLabels  TaskLabel[]
  timeEntries    TimeEntry[]
  timesheets  Timesheet[]
  milestones  Milestone[]
  projectActivities ProjectActivity[]
  issues        Issue[]
  issueComments IssueComment[]
  notifications Notification[]
  profiles      Profile[]
  projectGroups ProjectGroup[]
  folders       ProjectFolder[]
  documents     ProjectDocument[]
  roles         Role[]
  taskLists     TaskList[]
  taskListTemplates TaskListTemplate[]
  taskListComments  TaskListComment[]
  taskDependencies  TaskDependency[]
  taskRecurrences   TaskRecurrence[]
  taskReminders     TaskReminder[]
  taskCustomFields  TaskCustomField[]
  dashboards        Dashboard[]

  @@map("organizations")
}

model OrganizationSettings {
  id                  String       @id @default(uuid())
  organizationId      String       @unique
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  theme               String       @default("dark")
  allowedEmailDomains String?
  timezone            String?
  dateFormat          String?
  language            String?
  currency            String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("organization_settings")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  firstName           String?
  lastName            String?
  hashedRt            String?              // hashed refresh token for session management
  isActive            Boolean              @default(true)
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  userRoles           UserRole[]
  userProfile         UserProfile?
  organizationMembers OrganizationMember[]
  auditLogs           AuditLog[]
  invitations         Invitation[]         @relation("InvitedByRelation")
  ownedProjects       Project[]            @relation("ProjectOwnerRelation")
  projectMembers      ProjectMember[]
  assignedTasks       Task[]               @relation("TaskAssignee")
  reportedTasks       Task[]               @relation("TaskReporter")
  taskComments        TaskComment[]
  taskListComments    TaskListComment[]
  taskAttachments     TaskAttachment[]
  taskWatchers        TaskWatcher[]
  taskActivities      TaskActivity[]
  timeEntries         TimeEntry[]
  timesheets          Timesheet[]
  approvedTimesheets  Timesheet[]          @relation("ApprovedTimesheets")
  projectActivities   ProjectActivity[]
  ownedMilestones     Milestone[]          @relation("MilestoneOwner")
  createdFolders      ProjectFolder[]      @relation("FolderCreatedBy")
  uploadedDocuments   ProjectDocument[]    @relation("DocumentUploadedBy")
  uploadedDocumentVersions ProjectDocumentVersion[] @relation("DocumentVersionUploadedBy")
  assignedIssues      Issue[]              @relation("IssueAssignee")
  reportedIssues      Issue[]              @relation("IssueReporter")
  issueComments       IssueComment[]
  issueActivities     IssueActivity[]
  notifications          Notification[]          @relation("UserNotifications")
  triggeredNotifications Notification[]          @relation("NotificationTriggeredBy")
  notificationPreference NotificationPreference?
  createdTaskListTemplates TaskListTemplate[] @relation("TaskListTemplateCreator")
  createdTaskRecurrences TaskRecurrence[] @relation("RecurrenceCreator")
  createdReminders       TaskReminder[]   @relation("ReminderCreator")
  receivedCustomReminders TaskReminder[]  @relation("CustomReminderUser")
  createdDashboards       Dashboard[]     @relation("DashboardCreator")
  dashboardShares         DashboardShare[] @relation("UserDashboardShares")

  @@map("users")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String       @default("ACTIVE") // ACTIVE, SUSPENDED, INVITED
  joinedAt       DateTime     @default(now())
  deletedAt      DateTime?

  @@unique([userId, organizationId])
  @@map("organization_members")
}

model Invitation {
  id             String       @id @default(uuid())
  email          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  invitedBy      String
  inviter        User         @relation("InvitedByRelation", fields: [invitedBy], references: [id], onDelete: Cascade)
  status         String       @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  acceptedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  @@map("invitations")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType     String
  entityId       String
  action         String
  oldValue       Json?
  newValue       Json?
  projectId      String?
  taskId         String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([projectId])
  @@index([taskId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  
  parentRoleId    String?
  parentRole      Role?            @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: SetNull)
  childRoles      Role[]           @relation("RoleHierarchy")
  
  organizationId  String?
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  invitations     Invitation[]

  @@map("roles")
}

model Permission {
  id                 String              @id @default(uuid())
  name               String              @unique
  description        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  rolePermissions    RolePermission[]
  profilePermissions ProfilePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Profile {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  isSystem           Boolean             @default(false)
  version            Int                 @default(1)
  organizationId     String?             // Null for default global templates, or specific to an org
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?           // Nullable for Soft-Archiving
  profilePermissions ProfilePermission[]
  userProfiles       UserProfile[]

  @@unique([name, organizationId])
  @@map("profiles")
}

model ProfilePermission {
  profileId    String
  permissionId String
  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([profileId, permissionId])
  @@map("profile_permissions")
}

model UserProfile {
  userId    String   @unique
  profileId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([userId, profileId])
  @@map("user_profiles")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  MEMBER
  CLIENT
}

enum ProjectVisibility {
  PRIVATE
  ORGANIZATION
}

enum ProjectBudgetType {
  NONE
  FIXED_COST
  BASED_ON_PROJECT_HOURS
  BASED_ON_STAFF_HOURS
  BASED_ON_TASK_HOURS
}

enum ProjectBillingMethod {
  NONE
  FIXED_RATE
  PROJECT_HOURLY_RATE
  STAFF_HOURLY_RATE
  TASK_HOURLY_RATE
}

enum TaskLayoutType {
  STANDARD
  KANBAN
  LIST
  GANTT
}

model Project {
  id             String               @id @default(uuid())
  name           String
  description    String?
  projectCode    String               @unique
  startDate      DateTime?
  endDate        DateTime?
  status         ProjectStatus        @default(ACTIVE)
  visibility     ProjectVisibility    @default(PRIVATE)
  currency       String               @default("USD")
  budgetType     ProjectBudgetType    @default(NONE)
  budgetAmount   Float?
  budgetHours    Float?
  billingMethod  ProjectBillingMethod @default(NONE)
  billingRate    Float?
  tags           String?
  isTemplate     Boolean              @default(false)
  taskLayout     TaskLayoutType       @default(STANDARD)
  groupId           String?
  group             ProjectGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  isStrict          Boolean              @default(false)
  workingDays       String               @default("1,2,3,4,5")
  hoursPerDay       Float                @default(8.0)
  allowClientAccess Boolean              @default(false)
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User                 @relation("ProjectOwnerRelation", fields: [ownerId], references: [id], onDelete: Cascade)
  settings       ProjectSettings?
  members        ProjectMember[]
  nextTaskNumber  Int                  @default(1)
  nextIssueNumber Int                  @default(1)
  tasks           Task[]
  timeEntries     TimeEntry[]
  milestones      Milestone[]
  activities      ProjectActivity[]
  issues          Issue[]
  folders         ProjectFolder[]
  documents       ProjectDocument[]
  notifications   Notification[]
  taskLists       TaskList[]
  dependencies    TaskDependency[]
  taskRecurrences TaskRecurrence[]
  taskCustomFields TaskCustomField[]
  dashboards       Dashboard[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  @@map("projects")
}

model ProjectGroup {
  id             String       @id @default(uuid())
  name           String
  description    String?
  color          String?      @default("#6366f1")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       Project[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@map("project_groups")
}

model ProjectSettings {
  id                 String   @id @default(uuid())
  projectId          String   @unique
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  allowTimeTracking  Boolean  @default(true)
  allowIssueTracking Boolean  @default(true)
  allowFileUploads   Boolean  @default(true)
  enabledTabs        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("project_settings")
}

model ProjectMember {
  id         String            @id @default(uuid())
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       ProjectMemberRole @default(MEMBER)
  hourlyRate Float?
  addedBy    String?
  joinedAt   DateTime          @default(now())
  deletedAt  DateTime?

  @@unique([projectId, userId])
  @@map("project_members")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskType {
  TASK
  BUG
  STORY
  IMPROVEMENT
}

enum TaskBillingType {
  BILLABLE
  NON_BILLABLE
}

model Task {
  id             String            @id @default(uuid())
  title          String
  description    String?
  taskNumber     Int
  status         TaskStatus        @default(TODO)
  priority       TaskPriority      @default(MEDIUM)
  type           TaskType          @default(TASK)
  progress       Int               @default(0)
  billingType    TaskBillingType   @default(BILLABLE)
  estimatedHours Float?
  startDate      DateTime?
  dueDate        DateTime?
  position       Int               @default(0)
  tags           String?
  customFields   String?
  
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  assigneeId     String?
  assignee       User?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  
  reporterId     String?
  reporter       User?             @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  
  milestoneId    String?
  milestone      Milestone?        @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  
  taskListId     String?
  taskList       TaskList?         @relation(fields: [taskListId], references: [id], onDelete: SetNull)
  
  parentTaskId   String?
  parentTask     Task?             @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks       Task[]            @relation("TaskSubtasks")
  
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  
  comments       TaskComment[]
  attachments    TaskAttachment[]
  watchers       TaskWatcher[]
  activities     TaskActivity[]
  labels         TaskLabelMapping[]
  timeEntries    TimeEntry[]
  issues         Issue[]
  documents      ProjectDocument[]
  notifications  Notification[]
  predecessorDependencies TaskDependency[] @relation("TaskSuccessorRelation")
  successorDependencies   TaskDependency[] @relation("TaskPredecessorRelation")
  
  recurringTaskId String?
  recurringTask   TaskRecurrence?   @relation("TaskToRecurrence", fields: [recurringTaskId], references: [id], onDelete: SetNull)
  recurrenceIndex Int?
  isRecurringTemplate Boolean       @default(false)
  reminders       TaskReminder[]

  @@unique([projectId, taskNumber])
  @@index([organizationId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([taskListId])
  @@index([parentTaskId])
  @@index([assigneeId])
  @@index([status])
  @@index([recurringTaskId])
  @@index([deletedAt])
  @@map("tasks")
}

model TaskLabel {
  id             String            @id @default(uuid())
  name           String
  color          String
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          TaskLabelMapping[]

  @@unique([name, organizationId])
  @@map("task_labels")
}

model TaskLabelMapping {
  taskId  String
  labelId String
  task    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   TaskLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_label_mappings")
}

model TaskComment {
  id             String       @id @default(uuid())
  taskId         String
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content        String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@map("task_comments")
}

model TaskAttachment {
  id             String       @id @default(uuid())
  taskId         String
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName       String
  fileUrl        String
  fileSize       Int
  uploadedById   String
  uploadedBy     User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  organizationId String
  createdAt      DateTime     @default(now())

  @@map("task_attachments")
}

model TaskWatcher {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@map("task_watchers")
}

model TaskActivity {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@map("task_activities")
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum TimeEntrySource {
  MANUAL
  TIMER
}

model Timesheet {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  startDate       DateTime
  endDate         DateTime
  status          TimesheetStatus @default(DRAFT)
  approvalComment String?
  
  approvedById    String?
  approvedBy      User?           @relation("ApprovedTimesheets", fields: [approvedById], references: [id], onDelete: SetNull)
  
  timeEntries     TimeEntry[]
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@map("timesheets")
}

model TimeEntry {
  id             String          @id @default(uuid())
  hours          Float           @default(0)
  loggedAt       DateTime
  description    String?
  billable       Boolean         @default(true)
  source         TimeEntrySource
  
  // Timer properties
  isTimerRunning Boolean         @default(false)
  timerStartedAt DateTime?
  
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  taskId         String?
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  timesheetId    String?
  timesheet      Timesheet?      @relation(fields: [timesheetId], references: [id], onDelete: SetNull)
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([projectId])
  @@index([taskId])
  @@index([userId])
  @@index([timesheetId])
  @@index([loggedAt])
  @@index([deletedAt])
  @@map("time_entries")
}

enum MilestoneFlag {
  INTERNAL
  EXTERNAL
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  ACHIEVED
  MISSED
}

model Milestone {
  id             String            @id @default(uuid())
  title          String
  description    String?
  startDate      DateTime?
  dueDate        DateTime?
  status         MilestoneStatus   @default(PLANNED)
  flag           MilestoneFlag     @default(INTERNAL)
  position       Int               @default(0)
  
  ownerId        String?
  owner          User?             @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  tasks          Task[]
  taskLists      TaskList[]
  projectActivities ProjectActivity[]
  
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@unique([projectId, title])
  @@map("milestones")
}

enum TaskListFlag {
  INTERNAL
  EXTERNAL
}

enum TaskListStatus {
  ACTIVE
  COMPLETED
}

model TaskList {
  id             String          @id @default(uuid())
  name           String
  description    String?
  flag           TaskListFlag    @default(INTERNAL)
  status         TaskListStatus  @default(ACTIVE)
  position       Int             @default(0)
  
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  milestoneId    String?
  milestone      Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  
  tasks          Task[]
  comments       TaskListComment[]
  notifications  Notification[]
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@index([projectId])
  @@index([organizationId])
  @@index([milestoneId])
  @@map("task_lists")
}

model TaskListComment {
  id             String       @id @default(uuid())
  taskListId     String
  taskList       TaskList     @relation(fields: [taskListId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content        String
  attachments    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([taskListId])
  @@index([organizationId])
  @@index([deletedAt])
  @@map("task_list_comments")
}

model TaskListTemplate {
  id             String       @id @default(uuid())
  name           String
  description    String?
  flag           TaskListFlag @default(INTERNAL)
  tasks          Json

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdById    String
  createdBy      User         @relation("TaskListTemplateCreator", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@map("task_list_templates")
}

model ProjectActivity {
  id             String       @id @default(uuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  milestoneId    String?
  milestone      Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  
  action         String       // MILESTONE_CREATED, MILESTONE_UPDATED, MILESTONE_ARCHIVED
  oldValue       String?      // stringified JSON
  newValue       String?      // stringified JSON
  createdAt      DateTime     @default(now())

  @@map("project_activities")
}

// ─── Document & File Management ─────────────────────────────────────────────

model ProjectFolder {
  id             String            @id @default(uuid())
  name           String
  description    String?
  
  parentId       String?
  parentFolder   ProjectFolder?    @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders     ProjectFolder[]   @relation("FolderHierarchy")
  
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  createdById    String
  createdBy      User              @relation("FolderCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  
  documents      ProjectDocument[]
  
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@unique([projectId, parentId, name])
  @@map("project_folders")
}

model ProjectDocument {
  id             String                   @id @default(uuid())
  name           String
  fileUrl        String
  fileSize       Int                      @default(0)
  mimeType       String?
  version        String                   @default("1.0")
  tags           String?                  // comma-separated tags
  
  folderId       String?
  folder         ProjectFolder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  
  projectId      String
  project        Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  uploadedById   String
  uploadedBy     User                     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  
  taskId         String?
  task           Task?                    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  
  issueId        String?
  issue          Issue?                   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  
  versions       ProjectDocumentVersion[]
  
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?

  @@map("project_documents")
}

model ProjectDocumentVersion {
  id           String          @id @default(uuid())
  documentId   String
  document     ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      String
  fileUrl      String
  fileSize     Int             @default(0)
  notes        String?
  
  uploadedById String
  uploadedBy   User            @relation("DocumentVersionUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  
  createdAt    DateTime        @default(now())

  @@map("project_document_versions")
}

// ─── Phase 8: Issue / Bug Tracking ───────────────────────────────────────────

enum IssueStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueType {
  BUG
  FEATURE_REQUEST
  IMPROVEMENT
  SUPPORT
}

model Issue {
  id          String        @id @default(uuid())
  title       String
  description String?
  issueNumber Int
  type        IssueType     @default(BUG)
  status      IssueStatus   @default(OPEN)
  priority    IssuePriority @default(MEDIUM)
  severity    IssueSeverity @default(MEDIUM)

  environment      String?
  reproductionSteps String?
  resolutionNotes  String?

  resolvedAt  DateTime?

  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assigneeId  String?
  assignee    User?         @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  reporterId  String?
  reporter    User?         @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  taskId      String?
  task        Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)

  comments    IssueComment[]
  activities  IssueActivity[]
  documents   ProjectDocument[]
  notifications Notification[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@unique([projectId, issueNumber])
  @@index([organizationId])
  @@index([projectId])
  @@index([taskId])
  @@index([assigneeId])
  @@index([status])
  @@index([deletedAt])
  @@map("issues")
}

model IssueComment {
  id             String       @id @default(uuid())
  issueId        String
  issue          Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content        String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@map("issue_comments")
}

model IssueActivity {
  id        String   @id @default(uuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@map("issue_activities")
}

// ─── Phase 9: Notifications ──────────────────────────────────────────────────

enum NotificationType {
  TASK_ASSIGNMENT
  TASK_UNASSIGNED
  TASK_STATUS_CHANGED
  TASK_PRIORITY_CHANGED
  TASK_DUE_DATE_CHANGED
  TASK_COMMENT
  TASK_MENTION
  TASK_ATTACHMENT
  TASK_COMPLETED
  TASK_REOPENED
  TASK_DEPENDENCY_COMPLETED
  TASK_REMINDER_DUE
  TASK_REMINDER_OVERDUE
  TASK_LIST_COMMENT
  ISSUE_ASSIGNMENT
  ISSUE_COMMENT
  ISSUE_RESOLVED
  MILESTONE_UPDATE
  TIMESHEET_SUBMITTED
  TIMESHEET_APPROVED
  TIMESHEET_REJECTED
  SYSTEM
  RECURRING_TASK_GENERATED
}

model Notification {
  id             String           @id @default(uuid())
  type           NotificationType
  title          String
  message        String
  isRead         Boolean          @default(false)
  readAt         DateTime?
  actionUrl      String?
  metadata       String?          // SQLite does not support native Json. Stored as stringified JSON.
  
  // Recipient of the notification
  userId         String
  user           User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  
  // Trigger Source (who caused the notification)
  triggeredById  String?
  triggeredBy    User?            @relation("NotificationTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  
  // Optional Entity Associations for deep-linking
  projectId      String?
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  taskId         String?
  task           Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  issueId        String?
  issue          Issue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  
  taskListId     String?
  taskList       TaskList?        @relation(fields: [taskListId], references: [id], onDelete: Cascade)
  
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  @@index([userId])
  @@index([isRead])
  @@index([organizationId])
  @@index([projectId])
  @@index([taskId])
  @@index([issueId])
  @@index([taskListId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("notifications")
}

model NotificationPreference {
  id                 String   @id @default(uuid())
  
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  taskAssignment     Boolean  @default(true)
  taskStatusChange   Boolean  @default(true)
  taskPriorityChange Boolean  @default(true)
  taskDueDateChange  Boolean  @default(true)
  taskComment        Boolean  @default(true)
  taskMention        Boolean  @default(true)
  taskAttachment     Boolean  @default(true)
  taskReminder       Boolean  @default(true)
  taskOverdue        Boolean  @default(true)
  taskDependency     Boolean  @default(true)
  recurringTask      Boolean  @default(true)
  taskListComment    Boolean  @default(true)

  issueAssignment    Boolean  @default(true)
  issueComment       Boolean  @default(true)
  
  milestoneUpdate    Boolean  @default(true)
  
  timesheetSubmitted Boolean  @default(true)
  timesheetApproved  Boolean  @default(true)
  timesheetRejected  Boolean  @default(true)

  emailNotifications Boolean  @default(true)
  inAppNotifications Boolean  @default(true)
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("notification_preferences")
}

// ─── Phase 15: Task Reminders ────────────────────────────────────────────────

enum ReminderType {
  BEFORE_DUE
  ON_DUE
  AFTER_DUE
  CUSTOM_DATE
}

enum ReminderRecipientType {
  ASSIGNEE
  REPORTER
  WATCHERS
  CUSTOM_USER
  ALL_STAKEHOLDERS
}

enum ReminderStatus {
  PENDING
  SENT
  DISMISSED
  CANCELLED
}

model TaskReminder {
  id                   String                @id @default(uuid())
  taskId               String
  task                 Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  organizationId       String
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  type                 ReminderType          @default(BEFORE_DUE)
  offsetMinutes        Int?                  // e.g. 15, 60, 1440 (1 day), 2880 (2 days)
  timeOfDay            String?               // e.g. "09:00" for ON_DUE / OVERDUE
  customDate           DateTime?             // for CUSTOM_DATE
  
  remindAt             DateTime              // Calculated scheduled trigger timestamp (UTC)
  
  recipientType        ReminderRecipientType @default(ASSIGNEE)
  recipientId          String?
  recipient            User?                 @relation("CustomReminderUser", fields: [recipientId], references: [id], onDelete: SetNull)
  
  repeatDailyIfOverdue Boolean               @default(false)
  status               ReminderStatus        @default(PENDING)
  lastSentAt           DateTime?
  
  createdById          String?
  createdBy            User?                 @relation("ReminderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?

  @@index([organizationId])
  @@index([taskId])
  @@index([status])
  @@index([remindAt])
  @@index([deletedAt])
  @@map("task_reminders")
}

// ─── Phase 13: Task Dependencies ─────────────────────────────────────────────

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

enum DependencyLinkType {
  HARD
  SOFT
}

model TaskDependency {
  id              String             @id @default(uuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  projectId       String
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  predecessorId   String
  predecessor     Task               @relation("TaskPredecessorRelation", fields: [predecessorId], references: [id], onDelete: Cascade)
  
  successorId     String
  successor       Task               @relation("TaskSuccessorRelation", fields: [successorId], references: [id], onDelete: Cascade)
  
  type            DependencyType     @default(FINISH_TO_START)
  lag             Int                @default(0) // Lag in working days (+N for lag, -N for lead)
  linkType        DependencyLinkType @default(HARD)
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([predecessorId, successorId])
  @@index([organizationId])
  @@index([projectId])
  @@index([predecessorId])
  @@index([successorId])
  @@map("task_dependencies")
}

// ─── Phase 14: Recurring Tasks System ────────────────────────────────────────

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurrenceEndType {
  NEVER
  ON_DATE
  AFTER_OCCURRENCES
}

enum RecurrenceNonWorkingDayAction {
  EXACT_DATE
  NEXT_WORKING_DAY
  PREVIOUS_WORKING_DAY
}

enum RecurrenceStatus {
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED
}

model TaskRecurrence {
  id                  String                        @id @default(uuid())
  organizationId      String
  organization        Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId           String
  project             Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Origin task that initiated the recurrence
  originalTaskId      String?
  
  frequency           RecurrenceFrequency           @default(WEEKLY)
  interval            Int                           @default(1) // Every N days/weeks/months/years
  
  // Weekly options: comma-separated day numbers (1=Mon..7=Sun or 0=Sun..6=Sat), e.g. "1,3,5"
  daysOfWeek          String?
  
  // Monthly options: day of month (1-31, or -1 for last day)
  dayOfMonth          Int?
  
  // Monthly relative options: weekOfMonth (1=1st, 2=2nd, 3=3rd, 4=4th, -1=last), relativeDayOfWeek (1=Mon..7=Sun)
  weekOfMonth         Int?
  relativeDayOfWeek   Int?
  
  // Yearly options: monthOfYear (1-12)
  monthOfYear         Int?
  
  // Non-working days handling based on project workingDays
  nonWorkingDayAction RecurrenceNonWorkingDayAction @default(NEXT_WORKING_DAY)
  
  // Recurrence range & bounds
  startDate           DateTime
  endType             RecurrenceEndType             @default(NEVER)
  endDate             DateTime?
  maxOccurrences      Int?
  
  // Execution tracking & idempotency
  status              RecurrenceStatus              @default(ACTIVE)
  occurrencesCount    Int                           @default(0)
  lastGeneratedDate   DateTime?
  nextRunDate         DateTime?
  
  // Task template snapshot (persists configuration if original task changes independently)
  taskTemplate        String?                       // Stringified JSON
  cloneSubtasks       Boolean                       @default(true)
  cloneAttachments    Boolean                       @default(false)
  
  // Creator
  createdById         String?
  createdBy           User?                         @relation("RecurrenceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  
  // Generated task instances
  tasks               Task[]                        @relation("TaskToRecurrence")
  
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  deletedAt           DateTime?

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([nextRunDate])
  @@index([deletedAt])
  @@map("task_recurrences")
}

// ─── Task Custom Fields System ───────────────────────────────────────────────

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DECIMAL
  CURRENCY
  PERCENTAGE
  DATE
  DATETIME
  CHECKBOX
  SELECT
  MULTI_SELECT
  USER
  URL
  EMAIL
  PHONE
}

model TaskCustomField {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  name           String          // Display label, e.g. "Release Version"
  apiName        String          // API/Internal identifier, e.g. "cf_release_version"
  type           CustomFieldType @default(TEXT)
  
  description    String?         // Help text/description for users
  placeholder    String?         // Placeholder text in input
  defaultValue   String?         // Stringified default value
  
  isRequired     Boolean         @default(false)
  isActive       Boolean         @default(true)
  showInList     Boolean         @default(true)
  showInKanban   Boolean         @default(false)
  showInGantt    Boolean         @default(false)
  
  options        String?         // JSON array of options for SELECT / MULTI_SELECT: [{ label, value, color }]
  validation     String?         // JSON object for validation: { minLength, maxLength, minValue, maxValue, minDate, maxDate, regex, regexMessage, decimalPlaces, currencyCode }
  
  position       Int             @default(0)
  section        String?         @default("General") // Form section grouping
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, projectId, apiName])
  @@index([organizationId])
  @@index([projectId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("task_custom_fields")
}

// ─── Custom Dashboards System ────────────────────────────────────────────────

enum DashboardVisibility {
  PRIVATE
  PROJECT_USERS
  PORTAL_USERS
  CUSTOM
}

enum DashboardAccessLevel {
  VIEWER
  EDITOR
  FULL_ACCESS
}

enum WidgetType {
  KPI_TOTAL_TASKS
  KPI_COMPLETED_TASKS
  KPI_PENDING_TASKS
  KPI_OVERDUE_TASKS
  KPI_TOTAL_MILESTONES
  KPI_COMPLETED_MILESTONES
  KPI_LOGGED_HOURS
  KPI_BILLABLE_HOURS
  KPI_NON_BILLABLE_HOURS
  KPI_PROJECT_PROGRESS
  CHART_TASK_STATUS
  CHART_TASK_PRIORITY
  CHART_TASK_ASSIGNEE
  CHART_TASK_LIST
  CHART_TASK_MILESTONE
  CHART_TASK_COMPLETION_TREND
  CHART_HOURS_LOGGED
  CHART_BILLABLE_VS_NON_BILLABLE
  TABLE_OVERDUE_TASKS
  TABLE_UPCOMING_TASKS
  TABLE_RECENT_TASKS
  TABLE_RECENT_TIME_LOGS
}

model Dashboard {
  id             String              @id @default(uuid())
  name           String
  description    String?
  isDefault      Boolean             @default(false)
  visibility     DashboardVisibility @default(PRIVATE)
  layout         String?             // JSON string storing canvas grid & widget layout options
  
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  projectId      String?             // Null for cross-project / portal-wide dashboards
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdById    String
  createdBy      User                @relation("DashboardCreator", fields: [createdById], references: [id], onDelete: Cascade)
  
  widgets        DashboardWidget[]
  shares         DashboardShare[]
  
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([projectId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("dashboards")
}

model DashboardWidget {
  id          String     @id @default(uuid())
  dashboardId String
  dashboard   Dashboard  @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  
  title       String
  type        WidgetType
  position    Int        @default(0)
  width       String     @default("HALF") // "FULL" (12-col), "HALF" (6-col), "THIRD" (4-col), "QUARTER" (3-col)
  config      String?    // JSON string for widget-level filters: { projectId, dateRange, status, priority, assigneeId, taskListId, milestoneId, chartType, limit }
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([dashboardId])
  @@map("dashboard_widgets")
}

model DashboardShare {
  id          String               @id @default(uuid())
  dashboardId String
  dashboard   Dashboard            @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User                 @relation("UserDashboardShares", fields: [userId], references: [id], onDelete: Cascade)
  
  accessLevel DashboardAccessLevel @default(VIEWER)
  createdAt   DateTime             @default(now())

  @@unique([dashboardId, userId])
  @@index([dashboardId])
  @@index([userId])
  @@map("dashboard_shares")
}
